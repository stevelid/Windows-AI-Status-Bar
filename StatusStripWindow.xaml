<Window x:Class="ClaudeUsageWidget.StatusStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows AI Status Bar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Width" Height="30"
        PreviewMouseLeftButtonDown="OnLeftButtonDown" PreviewMouseMove="OnMouseMove"
        MouseLeftButtonUp="OnLeftButtonUp" MouseRightButtonUp="OnRightButtonUp">
    <Border x:Name="RootBorder" CornerRadius="9" Background="#E6191922"
            BorderThickness="1" Padding="9,0">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="12"
                              ShadowDepth="2" Direction="270" Opacity="0.38"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="CodexText" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  ·  " FontSize="11" VerticalAlignment="Center"
                       Foreground="#FF777782" IsHitTestVisible="False"/>
            <TextBlock x:Name="ClaudeText" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  ·  " FontSize="11" VerticalAlignment="Center"
                       Foreground="#FF777782" IsHitTestVisible="False"/>
            <TextBlock x:Name="WorkingText" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="DoneText" FontSize="11" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="GoAheadText" FontSize="11" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Border x:Name="AttentionPill" CornerRadius="6" Padding="5,1"
                    Margin="6,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AttentionText" FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
