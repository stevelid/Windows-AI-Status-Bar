<Window x:Class="ClaudeUsageWidget.DetailsPaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeUsageWidget"
        Title="Windows AI Status Details"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SizeToContent="Height" Width="390" MaxHeight="640"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnActivity" PreviewMouseMove="OnActivity">
    <Window.Resources>
        <SolidColorBrush x:Key="PaneTextBrush" Color="#E0E0E7"/>
        <SolidColorBrush x:Key="PaneMutedBrush" Color="#8A8A96"/>
        <SolidColorBrush x:Key="PaneSurfaceBrush" Color="#1B1B24"/>
        <SolidColorBrush x:Key="PaneHoverBrush" Color="#30303C"/>
        <SolidColorBrush x:Key="PaneBorderBrush" Color="#4B4C56"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PaneTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaneHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaneHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PaneSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PaneTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PaneBorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PaneTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PaneHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
    <Border x:Name="RootBorder" CornerRadius="12" BorderThickness="1"
            Padding="14" Background="#F21B1B24">
        <Border.Effect>
            <DropShadowEffect x:Name="PaneShadow" BlurRadius="18" ShadowDepth="3"
                              Direction="270" Opacity="0.45"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="610">
            <StackPanel x:Name="ContentPanel">
                <TextBlock x:Name="CodexHeading" FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <local:RateStrip x:Name="CodexRate" Height="24" Margin="5,0,5,3" Visibility="Collapsed"/>
                <StackPanel x:Name="CodexUsageRows"/>
                <TextBlock x:Name="CodexHealth" FontSize="10" TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="ClaudeHeading" FontSize="11" FontWeight="Bold"
                           Margin="0,7,0,5"/>
                <local:RateStrip x:Name="ClaudeRate" Height="24" Margin="5,0,5,3" Visibility="Collapsed"/>
                <StackPanel x:Name="ClaudeUsageRows"/>
                <TextBlock x:Name="ClaudeHealth" FontSize="10" TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,7,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProjectsTab" Grid.Column="0" Padding="3,4" Margin="0,0,12,0"
                            Click="OnProjectsTabClick"/>
                    <Button x:Name="ConversationsTab" Grid.Column="1" Padding="3,4"
                            Click="OnConversationsTabClick"/>
                    <TextBlock x:Name="SummaryStatus" Grid.Column="3" FontSize="10" MaxWidth="90"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PaneMutedBrush}"
                               VerticalAlignment="Center" Margin="5,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="MarkAllSeen" Grid.Column="4" FontSize="10" Cursor="Hand"
                               Foreground="{DynamicResource PaneMutedBrush}" VerticalAlignment="Center"
                               Margin="5,0" Visibility="Collapsed" MouseLeftButtonUp="OnMarkAllSeenClick"/>
                    <Button x:Name="ProjectOptions" Grid.Column="5" Content="⋯" FontSize="16" Padding="5,0"
                            Click="OnProjectOptionsClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="SummaryToggleMenuItem" Click="OnSummaryToggleClick"/>
                                <Separator/>
                                <MenuItem x:Name="ClearProjectsMenuItem" Click="OnClearProjectsClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <Separator x:Name="TaskDivider" Margin="0,3,0,6"/>
                <StackPanel x:Name="ProjectOverviewRows" Visibility="Collapsed" MouseLeave="OnProjectRowsLeave"/>
                <StackPanel x:Name="ConversationTasks">
                <TextBlock x:Name="NeedsYouHeading" FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,4" Visibility="Collapsed"/>
                <StackPanel x:Name="NeedsYouRows"/>
                <TextBlock x:Name="WorkingHeading" FontSize="11" FontWeight="Bold"
                           Margin="0,5,0,4" Visibility="Collapsed"/>
                <StackPanel x:Name="WorkingRows"/>
                <TextBlock x:Name="UnknownHeading" FontSize="11" FontWeight="Bold"
                           Margin="0,5,0,4" Visibility="Collapsed"/>
                <StackPanel x:Name="UnknownRows"/>
                <Grid x:Name="RecentHeader" Margin="0,5,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="RecentHeading" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecentClear" FontSize="10" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnClearFinishedClick"/>
                </Grid>
                <StackPanel x:Name="RecentRows"/>
                <Border x:Name="HistoryHeader" Margin="0,8,0,3" Padding="0,3" Cursor="Hand"
                        Background="Transparent" Visibility="Collapsed"
                        MouseLeftButtonUp="OnHistoryToggleClick">
                    <Grid>
                        <TextBlock x:Name="HistoryHeading" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HistoryClear" FontSize="10" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed"
                                   MouseLeftButtonUp="OnClearHistoryClick"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="HistoryRows" Visibility="Collapsed"/>
                <TextBlock x:Name="EmptyTasks" FontSize="11" TextWrapping="Wrap"
                           Margin="0,7,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel x:Name="OtherPcSection" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock x:Name="OtherPcHeading" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource PaneTextBrush}"/>
                    <TextBlock x:Name="OtherPcStatus" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"
                               Foreground="{DynamicResource PaneMutedBrush}"/>
                    <StackPanel x:Name="OtherPcRows"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
        <Popup x:Name="ProjectPeekPopup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border x:Name="ProjectPeekCard" Width="310" MaxHeight="560" CornerRadius="10" BorderThickness="1"
                    Padding="12" Background="{DynamicResource PaneSurfaceBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                    TextElement.Foreground="{DynamicResource PaneTextBrush}"
                    MouseEnter="OnProjectPeekEnter">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="530">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProjectPeekTitle" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button x:Name="ProjectPeekPin" Grid.Column="1" Content="Pin" Padding="6,2" Margin="5,0" Click="OnProjectPeekPinClick"/>
                            <Button Grid.Column="2" Content="×" Padding="6,2" Click="OnProjectPeekCloseClick"/>
                        </Grid>
                        <TextBlock x:Name="ProjectPeekMeta" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PaneMutedBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ProjectPeekSummary" TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <StackPanel x:Name="ProjectPeekRows"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
